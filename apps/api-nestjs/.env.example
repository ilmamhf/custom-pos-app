PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://pos:pos@localhost:15432/pos?schema=public"
JWT_ACCESS_SECRET="pos-access-secret-key-12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="pos-refresh-secret-key-67890"
JWT_REFRESH_EXPIRES_IN="7d"
# Lifetime of the signed offline authorization grant returned by /auth/verify-pin
OFFLINE_GRANT_TTL="12h"
# Development may use "*"; production must be an explicit comma-separated allowlist
CORS_ORIGIN="*"
# Swagger is disabled in production unless this is "true"
SWAGGER_ENABLED="false"
