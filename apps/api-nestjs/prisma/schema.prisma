// Prisma Schema matching docs/mvp-design/02-db-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum StockLedgerReason {
  SALE
  RESTOCK
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REFUND
}

enum PaymentMethod {
  CASH
  QRIS
  CARD
  SPLIT
}

enum PaymentProviderType {
  MIDTRANS
  XENDIT
  GENERIC
}

enum PaymentTransactionStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  VOIDED
  REFUNDED
  FAILED
  SETTLED
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  VOID
  REFUND
  SETTLEMENT
}

enum NegativeStockAction {
  ALERT_ONLY
  AUTO_TRANSFER
  MANAGER_APPROVAL
  WRITE_OFF
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Store {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(100)
  code                  String   @unique @db.VarChar(10)
  address               String?  @db.Text
  taxRateBps            Int      @default(1100) @map("tax_rate_bps")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  userStores            UserStore[]
  shifts                Shift[]
  sales                 Sale[]
  storeInventory        StoreInventory[]
  stockLedgers          StockLedger[]
  negativeStockPolicies NegativeStockPolicy[]
  negativeStockEvents   NegativeStockEvent[]

  @@map("stores")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.Text
  pinHash      String?  @map("pin_hash") @db.Text
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  userStores          UserStore[]
  shifts              Shift[]
  sales               Sale[]
  stockLedgers        StockLedger[]
  refunds             Refund[]
  negativeStockEvents NegativeStockEvent[]

  @@map("users")
}

model UserStore {
  userId  String @map("user_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_stores")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  sku       String   @unique @db.VarChar(50)
  barcode   String?  @db.VarChar(64)
  name      String   @db.VarChar(150)
  basePrice BigInt   @map("base_price")
  costPrice BigInt   @default(0) @map("cost_price")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  storeInventory       StoreInventory[]
  saleItems            SaleItem[]
  stockLedgers         StockLedger[]
  negativeStockEvents  NegativeStockEvent[]

  @@index([barcode])
  @@map("products")
}

model StoreInventory {
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  priceOverride BigInt?  @map("price_override")
  stockOnHand   Int      @default(0) @map("stock_on_hand")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([storeId, productId])
  @@map("store_inventory")
}

model StockLedger {
  id          String            @id @default(uuid()) @db.Uuid
  storeId     String            @map("store_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  deltaQty    Int               @map("delta_qty")
  reason      StockLedgerReason
  referenceId String?           @map("reference_id") @db.VarChar(100)
  note        String?           @db.Text
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([storeId])
  @@index([productId])
  @@map("stock_ledger")
}

model Shift {
  id           String    @id @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  openedAt     DateTime  @map("opened_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  openingCash  BigInt    @map("opening_cash")
  expectedCash BigInt?   @map("expected_cash")
  actualCash   BigInt?   @map("actual_cash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store Store  @relation(fields: [storeId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]

  @@map("shifts")
}

model Sale {
  id                String        @id @db.Uuid
  storeId           String        @map("store_id") @db.Uuid
  shiftId           String        @map("shift_id") @db.Uuid
  cashierId         String        @map("cashier_id") @db.Uuid
  receiptNo         String        @unique @map("receipt_no") @db.VarChar(40)
  subtotal          BigInt
  taxTotal          BigInt        @map("tax_total")
  discountTotal     BigInt        @default(0) @map("discount_total")
  grandTotal        BigInt        @map("grand_total")
  taxRateBps        Int           @default(0) @map("tax_rate_bps")
  paymentMethod     PaymentMethod @map("payment_method")
  status            SaleStatus
  createdAt         DateTime      @map("created_at") @db.Timestamptz

  store             Store              @relation(fields: [storeId], references: [id])
  shift             Shift              @relation(fields: [shiftId], references: [id])
  cashier           User               @relation(fields: [cashierId], references: [id])
  saleItems         SaleItem[]
  refunds           Refund[]
  tenders           SaleTender[]
  paymentTransactions PaymentTransaction[]

  @@index([storeId])
  @@map("sales")
}

model SaleItem {
  id                  String  @id @default(uuid()) @db.Uuid
  saleId              String  @map("sale_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(150)
  unitPrice           BigInt  @map("unit_price")
  qty                 Int
  refundedQty         Int     @default(0) @map("refunded_qty")
  grossAmount         BigInt  @default(0) @map("gross_amount")
  discountAmount      BigInt  @default(0) @map("discount_amount")
  taxAmount           BigInt  @default(0) @map("tax_amount")
  lineTotal           BigInt  @default(0) @map("line_total")
  refundedAmount      BigInt  @default(0) @map("refunded_amount")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model PaymentProvider {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(100)
  type          PaymentProviderType
  config        Json                // endpoint, merchant_id, api_key, etc.
  supportedMethods PaymentMethod[]
  isActive      Boolean             @default(true)
  isDefault     Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  transactions  PaymentTransaction[]

  @@map("payment_providers")
}

model PaymentTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  providerId      String                   @map("provider_id") @db.Uuid
  saleId          String?                  @map("sale_id") @db.Uuid
  tenderId        String?                  @unique @map("tender_id") @db.Uuid
  type            PaymentTransactionType
  status          PaymentTransactionStatus @default(PENDING)
  paymentMethod   PaymentMethod            @map("payment_method")
  amount          BigInt                   // amount in minor units (IDR)
  currency        String                   @default("IDR") @db.VarChar(3)
  externalId      String?                  @map("external_id") @db.VarChar(100) // provider's transaction ID
  reference       String?                  @db.VarChar(100) // merchant reference
  requestPayload  Json?                    @map("request_payload")
  responsePayload Json?                    @map("response_payload")
  errorMessage    String?                  @map("error_message") @db.Text
  idempotencyKey  String?                  @unique @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  settledAt       DateTime?                @map("settled_at") @db.Timestamptz

  provider        PaymentProvider          @relation(fields: [providerId], references: [id])
  sale            Sale?                    @relation(fields: [saleId], references: [id])
  tender          SaleTender?              @relation(fields: [tenderId], references: [id])

  @@index([providerId])
  @@index([saleId])
  @@index([externalId])
  @@index([idempotencyKey])
  @@map("payment_transactions")
}

model SaleTender {
  id                      String        @id @default(uuid()) @db.Uuid
  saleId                  String        @map("sale_id") @db.Uuid
  paymentMethod           PaymentMethod @map("payment_method")
  amount                  BigInt        // amount tendered for this method
  change                  BigInt        @default(0) // change given (for cash)
  reference               String?       @db.VarChar(100) // external payment reference (QRIS/Card)
  paymentTransactionId    String?       @unique @map("payment_transaction_id") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz

  sale                    Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentTransaction      PaymentTransaction?

  @@index([saleId])
  @@map("sale_tenders")
}

model Refund {
  id             String   @id @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  amount         BigInt
  reason         String?  @db.Text
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  sale    Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([saleId])
  @@map("refunds")
}

model NegativeStockPolicy {
  id                String              @id @default(uuid()) @db.Uuid
  storeId           String?             @unique @map("store_id") @db.Uuid
  alertThreshold    Int                 @default(0) @map("alert_threshold")
  autoTransferThreshold Int             @default(-10) @map("auto_transfer_threshold")
  approvalThreshold Int                 @default(-50) @map("approval_threshold")
  writeOffThreshold Int                 @default(-100) @map("write_off_threshold")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  store             Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("negative_stock_policies")
}

model NegativeStockEvent {
  id                String              @id @default(uuid()) @db.Uuid
  storeId           String              @map("store_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  currentStock      Int                 @map("current_stock")
  actionTaken       NegativeStockAction @map("action_taken")
  detail            Json?
  resolvedBy        String?             @map("resolved_by") @db.Uuid
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  store             Store               @relation(fields: [storeId], references: [id])
  product           Product             @relation(fields: [productId], references: [id])
  resolver          User?               @relation(fields: [resolvedBy], references: [id])

  @@index([storeId, productId])
  @@index([createdAt])
  @@map("negative_stock_events")
}
